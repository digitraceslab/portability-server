[Unit]
Description=portability-server celery beat
After=network.target redis-server.service

[Service]
User=@RUN_USER@
Group=@RUN_USER@
UMask=077
# Secrets come from /etc/credstore/portability.* (root-only), never from .env
ImportCredential=portability.*
StateDirectory=portability
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/venv/bin/celery -A portability_server beat -l info --schedule=/var/lib/portability/celerybeat-schedule
Restart=always

[Install]
WantedBy=multi-user.target
