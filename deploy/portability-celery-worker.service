[Unit]
Description=portability-server celery worker
After=network.target redis-server.service

[Service]
User=@RUN_USER@
Group=@RUN_USER@
UMask=077
# Secrets come from /etc/credstore/portability.* (root-only), never from .env
ImportCredential=portability.*
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/venv/bin/celery -A portability_server worker -l info
Restart=always

[Install]
WantedBy=multi-user.target
