[Unit]
Description=portability-server gunicorn
After=network.target

[Service]
User=@RUN_USER@
Group=@RUN_USER@
UMask=077
# Secrets come from /etc/credstore/portability.* (root-only), never from .env
ImportCredential=portability.*
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/venv/bin/gunicorn --access-logfile - --workers 3 --timeout 120 --bind unix:/run/portability/portability-server.sock portability_server.wsgi:application
RuntimeDirectory=portability

[Install]
WantedBy=multi-user.target
