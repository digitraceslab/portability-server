SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production (DEBUG=False), e.g. https://your.domain
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://portability_user:password@localhost:5432/portability_db

# OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SANDBOX_MODE=False

# OAuth callback URLs (must match what is registered with each provider)
GOOGLE_REDIRECT_URI=
TIKTOK_REDIRECT_URI=

# Encryption (required; base64 urlsafe Fernet key)
ENCRYPTION_KEY=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_URL=redis://localhost:6379/2

# Maximum accepted upload size in bytes (default 55 GB)
UPLOAD_MAX_BYTES=

# Virus scanning of ingested files
CLAMAV_ENABLED=

# Where downloaded and uploaded archives are held while they are processed.
# Everything in this directory is disposable: archives are deleted as soon as
# they have been read, and anything a crash left behind is removed once it
# passes ARCHIVE_MAX_AGE_SECONDS (default 24 hours).
ARCHIVE_DIR=
ARCHIVE_MAX_AGE_SECONDS=

# Seconds a processing task may run. Reading and scanning a large export
# takes hours, not minutes (default 21600).
CELERY_TASK_TIME_LIMIT=

# How long donated data is kept, in days: from arrival (default 14), and from
# a researcher confirming they hold a verified copy (default 2). Donations
# expiring within RETENTION_WARNING_DAYS are named in the daily mail.
RETENTION_DAYS=
CAN_DELETE_RETENTION_DAYS=
RETENTION_WARNING_DAYS=

# Mail is delivered through the local mail transfer agent. EMAIL_FROM must be
# an aalto.fi address; the local part does not matter. ADMIN_EMAILS is a
# comma-separated list and should match VERIFY_EMAIL used by scripts/verify.sh.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_FROM=
ADMIN_EMAILS=

# Domains served by nginx, comma-separated; one server block is rendered per
# domain, each using /etc/letsencrypt/live/<domain>/. Defaults to the first
# entry of ALLOWED_HOSTS when unset.
DOMAINS=

# Deployment paths used by scripts/deploy.sh and scripts/update.sh.
# APP_DIR defaults to the repository root, VENV_PATH to $APP_DIR/venv.
APP_DIR=
VENV_PATH=
