SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production (DEBUG=False), e.g. https://your.domain
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://portability_user:password@localhost:5432/portability_db

# OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SANDBOX_MODE=False

# OAuth callback URLs (must match what is registered with each provider)
GOOGLE_REDIRECT_URI=
TIKTOK_REDIRECT_URI=

# Encryption (required; base64 urlsafe Fernet key)
ENCRYPTION_KEY=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_URL=redis://localhost:6379/2

# Maximum accepted upload size in bytes (default 55 GB)
UPLOAD_MAX_BYTES=

# Virus scanning of ingested files
CLAMAV_ENABLED=

# Domains served by nginx, comma-separated; one server block is rendered per
# domain, each using /etc/letsencrypt/live/<domain>/. Defaults to the first
# entry of ALLOWED_HOSTS when unset.
DOMAINS=

# Deployment paths used by scripts/deploy.sh and scripts/update.sh.
# APP_DIR defaults to the repository root, VENV_PATH to $APP_DIR/venv.
APP_DIR=
VENV_PATH=
